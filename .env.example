# =============================================================================
# n8n Configuration
# =============================================================================
# Enable/disable basic authentication for n8n web interface
N8N_BASIC_AUTH_ACTIVE=true

# Username for n8n login (change for security)
N8N_BASIC_AUTH_USER=admin

# Password for n8n login (CHANGE THIS for security!)
N8N_BASIC_AUTH_PASSWORD=change_this_password

# Host where n8n will run (usually localhost for local setups)
N8N_HOST=localhost

# Port for n8n web interface (default: 5678)
N8N_PORT=5678

# Protocol for n8n (http for local, https for production with SSL)
N8N_PROTOCOL=http

# =============================================================================
# Claude API Configuration
# =============================================================================
# Get your API key from: https://console.anthropic.com/
# 1. Sign up or log in to your Anthropic account
# 2. Navigate to "API Keys" section
# 3. Click "Create Key"
# 4. Copy the key (starts with sk-ant-api03-)
# Format: sk-ant-api03-...
CLAUDE_API_KEY=sk-ant-api03-your-key-here

# Claude model to use (claude-sonnet-4-5 recommended for code analysis)
# Options: claude-sonnet-4-5, claude-opus-4, claude-haiku-4
CLAUDE_MODEL=claude-sonnet-4-5

# =============================================================================
# Git Configuration
# =============================================================================
# Git user name for automated commits (identifies the bot in commit history)
# This name will appear in git log for all automated commits
GIT_USER_NAME=n8n-automation-bot

# Git email for automated commits (should be a valid email for your organization)
# This email will appear in git log for all automated commits
GIT_USER_EMAIL=bot@yourcompany.com

# GitHub Personal Access Token - Get from: https://github.com/settings/tokens
# 1. Go to GitHub Settings → Developer settings → Personal access tokens → Tokens (classic)
# 2. Click "Generate new token (classic)"
# 3. Give it a name: "n8n Dependency Automation"
# 4. Select scopes:
#    - repo (Full control of private repositories)
#    - workflow (Update GitHub Actions workflows)
# 5. Click "Generate token" and copy it immediately (you won't see it again!)
# Format: ghp_...
GITHUB_TOKEN=ghp_your_github_token_here

# GitHub repository owner (your username or organization name)
# Example: For https://github.com/myusername/myrepo, owner is "myusername"
GITHUB_REPO_OWNER=your-github-username

# GitHub repository name (the repo where PRs will be created)
# Example: For https://github.com/myusername/myrepo, name is "myrepo"
GITHUB_REPO_NAME=your-repo-name

# =============================================================================
# Confluence Configuration
# =============================================================================
# Your Atlassian domain (without https:// or /wiki)
# Example: If your Confluence URL is https://mycompany.atlassian.net/wiki/...
# Then enter: mycompany.atlassian.net
CONFLUENCE_DOMAIN=yourcompany.atlassian.net

# Email associated with your Atlassian account
# This is the email you use to log in to Confluence
CONFLUENCE_EMAIL=your-email@company.com

# Confluence API Token - Get from: https://id.atlassian.com/manage-profile/security/api-tokens
# 1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Click "Create API token"
# 3. Enter a label: "n8n Automation"
# 4. Click "Create" and copy the token immediately
# Format: ATATT3xFfGF0...
CONFLUENCE_API_TOKEN=your_confluence_api_token

# Confluence space key (DEV, TECH, etc.)
# Optional if using page ID directly, but recommended for clarity
# Find it in your space URL: /wiki/spaces/DEV/... (DEV is the space key)
CONFLUENCE_SPACE_KEY=DEV

# Parent page ID where automation docs will be created as child pages
# Find this by:
# 1. Open the Confluence page where you want docs to appear as children
# 2. Click the "..." menu → "Page Information"
# 3. Look at the URL for pageId=NUMBER
#    Example URL: https://yourcompany.atlassian.net/wiki/pages/viewinfo.action?pageId=123456789
#    The page ID is: 123456789
#
# Alternative method (modern URL format):
# 1. Open your Confluence page
# 2. Look at the URL: https://yourcompany.atlassian.net/wiki/spaces/~xxx/pages/327682/Page+Title
# 3. The number after /pages/ is your page ID (in this example: 327682)
CONFLUENCE_PARENT_PAGE_ID=123456789

# =============================================================================
# Project Configuration
# =============================================================================
# Absolute path to your Angular project that will be analyzed and updated
# Must be an absolute path, not relative
# Example for macOS/Linux: /Users/yourname/projects/my-angular-app
# Example for Windows: C:/Users/yourname/projects/my-angular-app
DEFAULT_PROJECT_PATH=/path/to/your/angular/project

# Number of times to retry failed operations (API calls, tests, etc.)
# Higher values increase resilience but may slow down error detection
# Recommended: 3-5
MAX_RETRY_ATTEMPTS=3

# Initial delay in milliseconds for exponential backoff retry strategy
# Each retry will wait longer: delay * 2^attempt
# 5000ms = 5 seconds initial delay
# Retries will wait: 5s, 10s, 20s, etc.
EXPONENTIAL_BACKOFF_DELAY=5000

# =============================================================================
# Optional: Notification Configuration
# =============================================================================
# These settings are optional and can be left empty if you don't want notifications

# Slack webhook URL for notifications (leave empty to disable)
# Get from: Slack → Your Workspace → Apps → Incoming Webhooks
# Format: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# Email SMTP server for email notifications (leave empty to disable)
# Examples: smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net
EMAIL_SMTP_HOST=

# SMTP port (587 for TLS, 465 for SSL, 25 for unencrypted)
# Recommended: 587 (TLS)
EMAIL_SMTP_PORT=587

# Email address to send notifications from
# Must be authorized to send via your SMTP server
EMAIL_FROM=

# Email address(es) to send notifications to
# For multiple recipients, separate with commas: user1@example.com,user2@example.com
EMAIL_TO=
