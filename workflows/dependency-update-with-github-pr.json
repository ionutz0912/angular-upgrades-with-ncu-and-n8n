      "name": "Read Test Results",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        2350,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout;\nconst data = JSON.parse(output);\n\nreturn {\n  json: {\n    testPassed: data.test.passed,\n    buildPassed: data.build.passed,\n    summary: `Tests: ${data.test.passed ? 'PASSED \u2713' : 'FAILED \u2717'} | Build: ${data.build.passed ? 'PASSED \u2713' : 'FAILED \u2717'}`\n  }\n};"
      },
      "id": "parse-test-results",
      "name": "Parse Test Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    message: \"No updates available\",\n    totalUpdates: 0\n  }\n};"
      },
      "id": "no-updates",
      "name": "No Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1250,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Get branch name from earlier in workflow\nconst branchOutput = $('Create Test Branch').first().json.stdout;\nconst branchMatch = branchOutput.match(/Switched to a new branch '([^']+)'/);\nlet branchName = branchMatch ? branchMatch[1] : 'test-deps-update';\n\n// If branch match failed, try to extract from stderr\nif (!branchMatch) {\n  const stderrOutput = $('Create Test Branch').first().json.stderr || '';\n  const stderrMatch = stderrOutput.match(/Switched to a new branch '([^']+)'/);\n  if (stderrMatch) {\n    branchName = stderrMatch[1];\n  }\n}\n\n// Get update info\nconst updateInfo = $('Parse Updates').first().json;\nconst testResults = $input.first().json;\n\n// Build PR title\nconst title = `Update Angular Dependencies - ${updateInfo.totalUpdates} packages (${new Date().toISOString().split('T')[0]})`;\n\n// Build PR body - handle updates array safely\nlet updateList = '';\nif (updateInfo.updates && Array.isArray(updateInfo.updates) && updateInfo.updates.length > 0) {\n  // Show first 10 updates, then indicate if there are more\n  const displayUpdates = updateInfo.updates.slice(0, 10);\n  updateList = displayUpdates.map(u =>\n    `- **${u.name}**: ${u.from} \u2192 ${u.to}`\n  ).join('\\n');\n\n  if (updateInfo.updates.length > 10) {\n    updateList += `\\n\\n...and ${updateInfo.updates.length - 10} more packages`;\n  }\n} else {\n  updateList = '_See commit for full list of dependency updates_';\n}\n\nconst body = `## \ud83d\udce6 Dependency Updates\n\nThis PR updates ${updateInfo.totalUpdates} packages to their latest versions.\n\n### Updates Applied\n${updateList}\n\n### Test Results\n| Check | Status |\n|-------|--------|\n| **Tests** | ${testResults.testPassed ? '\u2705 PASSED' : '\u274c FAILED'} |\n| **Build** | ${testResults.buildPassed ? '\u2705 PASSED' : '\u274c FAILED'} |\n\n### Details\n- **Branch**: \\`${branchName}\\`\n- **Generated**: ${new Date().toISOString()}\n- **Automated by**: n8n dependency update workflow\n\n---\n*This PR was automatically generated. Please review the changes before merging.*\n`;\n\nreturn {\n  json: {\n    title: title,\n    body: body,\n    branchName: branchName,\n    updateCount: updateInfo.totalUpdates\n  }\n};"
      },
