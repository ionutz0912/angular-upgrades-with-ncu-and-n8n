    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout;\n\ntry {\n  const data = JSON.parse(output);\n\n  return {\n    json: {\n      success: data.success,\n      prExists: data.prExists || false,\n      prNumber: data.pr ? data.pr.number : null,\n      prUrl: data.pr ? data.pr.url : null,\n      prState: data.pr ? data.pr.state : null,\n      message: data.prExists ? 'PR already exists' : 'PR created successfully',\n      repository: data.repository || {},\n      timestamp: data.timestamp || new Date().toISOString()\n    }\n  };\n} catch (e) {\n  return {\n    json: {\n      success: false,\n      error: 'Failed to parse PR response',\n      rawOutput: output\n    }\n  };\n}"
      },
      "id": "parse-pr-response",
      "name": "Parse PR Response",
