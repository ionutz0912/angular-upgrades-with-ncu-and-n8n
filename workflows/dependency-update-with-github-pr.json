        "command": "=/Users/pato/github/ionutz0912/ng-ncu-n8n/scripts/create-github-pr.sh /Users/pato/github/ionutz0912/angular-test-project {{ $('Prepare PR Data').first().json.branchName }} /tmp/pr-data.json $GITHUB_TOKEN main"
      },
      "id": "create-github-pr",
      "name": "Create GitHub PR",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
