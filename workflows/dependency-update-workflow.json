{
  "name": "Angular Dependency Update with npm Install Fixes",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "cd /Users/pato/github/ionutz0912/angular-test-project && git checkout -b test-deps-update_$(date +%m-%d-%Y_%I-%M-%S_%p)"
      },
      "id": "create-branch",
      "name": "Create Test Branch",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "command": "/Users/pato/github/ionutz0912/ng-ncu-n8n/scripts/update-dependencies.sh /Users/pato/github/ionutz0912/angular-test-project /tmp/ncu-test.json"
      },
      "id": "check-updates",
      "name": "Check for Updates",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout;\nconst data = JSON.parse(output);\n\nreturn {\n  json: {\n    hasUpdates: data.hasUpdates,\n    totalUpdates: data.totalUpdates,\n    updates: data.upgrades,\n    projectPath: data.projectPath\n  }\n};"
      },
      "id": "parse-updates",
      "name": "Parse Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.hasUpdates}}",
              "value2": true
            }
          ]
        }
      },
      "id": "has-updates",
      "name": "Has Updates?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "command": "cd /Users/pato/github/ionutz0912/angular-test-project && ncu -u"
      },
      "id": "apply-updates",
      "name": "Apply Updates to package.json",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "command": "cd /Users/pato/github/ionutz0912/angular-test-project && git add package.json && git commit -m \"Update package.json - $(date +%Y-%m-%d)\""
      },
      "id": "commit-package-json",
      "name": "Commit package.json",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "command": "/Users/pato/github/ionutz0912/ng-ncu-n8n/scripts/npm-install-with-capture.sh /Users/pato/github/ionutz0912/angular-test-project /tmp/install-results.json"
      },
      "id": "npm-install",
      "name": "Run npm install",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1650, 200],
      "continueOnFail": true
    },
    {
      "parameters": {
        "command": "cat /tmp/install-results.json"
      },
      "id": "read-install-results",
      "name": "Read Install Results",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1750, 200]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout;\nconst data = JSON.parse(output);\n\nreturn {\n  json: {\n    status: data.status,\n    hasErrors: data.hasErrors,\n    installPassed: data.install.passed,\n    installExitCode: data.install.exitCode,\n    dependencyErrors: data.install.dependencyErrors,\n    fullOutput: data.install.output\n  }\n};"
      },
      "id": "parse-install-results",
      "name": "Parse Install Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1850, 200]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.hasErrors}}",
              "value2": true
            }
          ]
        }
      },
      "id": "has-install-errors",
      "name": "Install Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "jsCode": "// Prepare error context for Claude\nconst errors = $input.first().json.dependencyErrors;\nconst fullOutput = $input.first().json.fullOutput;\n\n// Create a temporary file with the errors\nconst errorContext = `npm install failed with the following dependency conflicts:\n\n${errors}\n\nFull output:\n${fullOutput}\n\nPlease analyze these dependency conflicts and provide fixes. Common solutions:\n1. Use --legacy-peer-deps flag\n2. Update conflicting peer dependencies\n3. Add resolutions to package.json\n4. Update package versions to compatible ranges\n`;\n\nreturn {\n  json: {\n    errorContext: errorContext,\n    errors: errors\n  }\n};"
      },
      "id": "prepare-claude-context",
      "name": "Prepare Error Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2250, 100]
    },
    {
      "parameters": {
        "command": "echo \"={{$json.errorContext}}\" > /tmp/install-errors.txt"
      },
      "id": "save-error-context",
      "name": "Save Error Context",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2450, 100]
    },
    {
      "parameters": {
        "command": "/Users/pato/github/ionutz0912/ng-ncu-n8n/scripts/apply-claude-fix.sh /Users/pato/github/ionutz0912/angular-test-project /tmp/install-errors.txt $CLAUDE_API_KEY /tmp/claude-fixes.json"
      },
      "id": "call-claude",
      "name": "Get Claude Fixes",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2650, 100],
      "continueOnFail": true
    },
    {
      "parameters": {
        "command": "cat /tmp/claude-fixes.json"
      },
      "id": "read-claude-response",
      "name": "Read Claude Response",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2750, 100]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout;\nconst data = JSON.parse(output);\n\nreturn {\n  json: {\n    fixes: data.fixes || [],\n    fixCount: (data.fixes || []).length,\n    claudeAnalysis: data.analysis || 'No analysis provided'\n  }\n};"
      },
      "id": "parse-claude-response",
      "name": "Parse Claude Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2850, 100]
    },
    {
      "parameters": {
        "command": "/Users/pato/github/ionutz0912/ng-ncu-n8n/scripts/apply-file-fixes.sh /Users/pato/github/ionutz0912/angular-test-project /tmp/claude-fixes.json"
      },
      "id": "apply-fixes",
      "name": "Apply Claude Fixes",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3050, 100]
    },
    {
      "parameters": {
        "command": "cd /Users/pato/github/ionutz0912/angular-test-project && git add . && git commit -m \"Apply Claude AI fix for npm install errors - $(date +%Y-%m-%d)\""
      },
      "id": "commit-fixes",
      "name": "Commit Fixes",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3250, 100]
    },
    {
      "parameters": {
        "command": "/Users/pato/github/ionutz0912/ng-ncu-n8n/scripts/npm-install-with-capture.sh /Users/pato/github/ionutz0912/angular-test-project /tmp/install-retry.json"
      },
      "id": "retry-install",
      "name": "Retry npm install",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3450, 100],
      "continueOnFail": true
    },
    {
      "parameters": {
        "command": "cat /tmp/install-retry.json"
      },
      "id": "read-retry-results",
      "name": "Read Retry Results",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3550, 100]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout;\nconst data = JSON.parse(output);\n\nreturn {\n  json: {\n    installPassed: data.install.passed,\n    message: data.install.passed ? 'npm install succeeded after fixes!' : 'npm install still failing',\n    status: data.status\n  }\n};"
      },
      "id": "check-retry-result",
      "name": "Check Retry Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3650, 100]
    },
    {
      "parameters": {
        "command": "/Users/pato/github/ionutz0912/ng-ncu-n8n/scripts/run-tests.sh /Users/pato/github/ionutz0912/angular-test-project /tmp/test-results.json"
      },
      "id": "run-tests",
      "name": "Run Tests & Build",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2250, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "command": "cat /tmp/test-results.json"
      },
      "id": "read-test-results",
      "name": "Read Test Results",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2350, 300]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout;\nconst data = JSON.parse(output);\n\nreturn {\n  json: {\n    testPassed: data.test.passed,\n    buildPassed: data.build.passed,\n    summary: `Tests: ${data.test.passed ? 'PASSED ✓' : 'FAILED ✗'} | Build: ${data.build.passed ? 'PASSED ✓' : 'FAILED ✗'}`\n  }\n};"
      },
      "id": "parse-test-results",
      "name": "Parse Test Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2450, 300]
    },
    {
      "parameters": {
        "jsCode": "return {\n  json: {\n    message: \"No updates available\",\n    totalUpdates: 0\n  }\n};"
      },
      "id": "no-updates",
      "name": "No Updates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 400]
    }
  ],
